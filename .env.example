# ==========================================
# ONE-PRODUCT STORE PLATFORM CONFIGURATION
# ==========================================

# 1. STRIPE PAYMENTS & 1-CLICK UPSELLS
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# 2. META (FACEBOOK & INSTAGRAM) ADS & CAPI (SERVER-SIDE)
# Get Pixel ID & Conversions API Token in Meta Events Manager
NEXT_PUBLIC_META_PIXEL_ID=123456789012345
META_PIXEL_ID=123456789012345
META_CAPI_ACCESS_TOKEN=EAAG...
# Optional: test event code from Meta Events Manager "Test Events" tab
META_TEST_EVENT_CODE=

# 3. TIKTOK ADS & EVENTS API (CAPI)
# Get from TikTok Ads Manager > Events
NEXT_PUBLIC_TIKTOK_PIXEL_ID=CXXXXXXXXXXXXX
TIKTOK_PIXEL_ID=CXXXXXXXXXXXXX
TIKTOK_EVENTS_API_TOKEN=

# 4. GOOGLE ADS & ANALYTICS 4
# Measurement ID: G-XXXXXXXXXX or AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_TAG_ID=G-XXXXXXXXXX

# 5. PINTEREST TAG & CAPI
NEXT_PUBLIC_PINTEREST_TAG_ID=261XXXXXXXXXX

# 6. KLAVIYO (EMAIL & SMS MARKETING)
# Create a Private API Key in Klaviyo Settings > API Keys
KLAVIYO_API_KEY=pk_...

# 7. DROPSHIPPING AUTOMATION (CJ DROPSHIPPING & TEEMDROP)
# Choice: "cj" | "teemdrop" | "both"
DROPSHIPPING_PROVIDER=cj

# CJ Dropshipping Open API (Use either CJ_API_KEY or CJ_DROPSHIPPING_ACCESS_TOKEN):
# Get API Key from: CJ App Store > API app (under Others) or My CJ > Authorization > API
CJ_API_KEY=
CJ_DROPSHIPPING_ACCESS_TOKEN=

# Teemdrop API Key:
# Get from: https://teemdrop.com
TEEMDROP_API_KEY=

# 8. AFTERSHIP BRANDED TRACKING (OPTIONAL)
AFTERSHIP_API_KEY=
